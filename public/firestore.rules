rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }
    function validUsername(value) {
      return value is string
        && value.size() >= 3 && value.size() <= 24
        && value.matches("[A-Za-z0-9_-][A-Za-z0-9 _-]{1,22}[A-Za-z0-9_-]")
        && value.matches(".*[A-Za-z0-9].*");
    }
    function validProfile(data) {
      return data.keys().hasAll(["username", "updatedAt"])
        && data.keys().hasOnly(["username", "updatedAt"])
        && validUsername(data.username)
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function validLeaderboard(uid, data) {
      return data.keys().hasAll(["uid", "displayName", "correct", "points", "pending", "rank", "updatedAt"])
        && data.keys().hasOnly(["uid", "displayName", "correct", "points", "pending", "rank", "updatedAt"])
        && data.uid == uid && validUsername(data.displayName)
        && data.correct is int && data.correct >= 0
        && data.points is int && data.points == data.correct
        && data.pending is int && data.pending >= 0
        && data.rank is int && data.rank >= 1
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    function room(id) {
      return get(/databases/$(database)/documents/rooms/$(id)).data;
    }
    function group(id) {
      return id in ["A", "B", "C", "D"];
    }
    function series(id) {
      return id in ["QF1", "QF2", "QF3", "QF4", "SF1", "SF2", "FINAL", "THIRD"];
    }
    function stage(id) {
      return group(id) ? "preliminary"
        : id in ["QF1", "QF2", "QF3", "QF4"] ? "quarterfinal"
        : id in ["SF1", "SF2"] ? "semifinal"
        : id in ["FINAL", "THIRD"] ? "final" : "";
    }
    function realPlayer(key) {
      return key is string && key.matches(".*\\S.*")
        && !key.matches("(?i)\\s*TBD\\s*");
    }
    function seed(id, index) {
      let r = room(id);
      return r.resultsPublished == true && r.qualifiers is list
        && r.qualifiers.size() == 2
        && r.qualifiers[0] != r.qualifiers[1]
        && realPlayer(r.qualifiers[0]) && realPlayer(r.qualifiers[1])
        && r.qualifiers[0] in r.players && r.qualifiers[1] in r.players
        ? r.qualifiers[index] : "";
    }
    function seriesResult(id, winner) {
      let r = room(id);
      let target = id == "FINAL" ? 11 : id in ["SF1", "SF2", "THIRD"] ? 9 : 7;
      let first = r.scores[0] == target;
      return r.formatVersion == 2 && r.resultsPublished == true
        && r.players.size() == 2 && r.players[0] != r.players[1]
        && realPlayer(r.players[0]) && realPlayer(r.players[1])
        && r.scores is list && r.scores.size() == 2
        && r.scores[0] is int && r.scores[1] is int
        && r.scores[0] >= 0 && r.scores[1] >= 0
        && ((first && r.scores[1] < target) || (r.scores[1] == target && r.scores[0] < target))
        && r.winner == r.players[first ? 0 : 1]
        && r.loser == r.players[first ? 1 : 0]
        ? (winner ? r.winner : r.loser) : "";
    }
    function feedsMatch(id, players) {
      return id == "QF1" ? players == [seed("A", 0), seed("B", 1)]
        : id == "QF2" ? players == [seed("C", 0), seed("D", 1)]
        : id == "QF3" ? players == [seed("B", 0), seed("A", 1)]
        : id == "QF4" ? players == [seed("D", 0), seed("C", 1)]
        : id == "SF1" ? players == [seriesResult("QF1", true), seriesResult("QF2", true)]
        : id == "SF2" ? players == [seriesResult("QF3", true), seriesResult("QF4", true)]
        : id == "FINAL" ? players == [seriesResult("SF1", true), seriesResult("SF2", true)]
        : id == "THIRD" && players == [seriesResult("SF1", false), seriesResult("SF2", false)];
    }
    function open(id) {
      let stageId = stage(id);
      return stageId != ""
        && get(/databases/$(database)/documents/settings/$("rounds_" + stageId)).data.predictionsOpen == true;
    }
    function ready(id) {
      let r = room(id);
      return r.players is list
        && (group(id) ? r.players.size() == 8
          : series(id) && r.formatVersion == 2
            && r.players.size() == 2 && r.players[0] != r.players[1]
            && realPlayer(r.players[0]) && realPlayer(r.players[1])
            && feedsMatch(id, r.players));
    }
    function available(id) {
      return ready(id) && open(id)
        && room(id).get("predictionsLocked", false) != true
        && room(id).resultsPublished != true
        && room(id).status != "completed";
    }
    function validPick(id, data) {
      return available(id)
        && data.keys().hasAll(["uid", "roomId", "stageId", "displayName", "selectedPlayers", "formatVersion", "updatedAt"])
        && data.keys().hasOnly(["uid", "roomId", "stageId", "displayName", "selectedPlayers", "formatVersion", "updatedAt"])
        && data.uid == request.auth.uid && data.roomId == id
        && data.stageId == stage(id) && data.formatVersion == 2
        && data.displayName is string && data.displayName.size() <= 100
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && data.selectedPlayers is list
        && (group(id)
          ? data.selectedPlayers.size() == 2
            && data.selectedPlayers[0] != data.selectedPlayers[1]
            && realPlayer(data.selectedPlayers[0]) && realPlayer(data.selectedPlayers[1])
            && data.selectedPlayers[0] in room(id).players && data.selectedPlayers[1] in room(id).players
          : series(id) && data.selectedPlayers.size() == 1
            && realPlayer(data.selectedPlayers[0]) && data.selectedPlayers[0] in room(id).players);
    }
    function ownsId(id) {
      return signedIn() && id in [
        request.auth.uid + "_A", request.auth.uid + "_B", request.auth.uid + "_C", request.auth.uid + "_D",
        request.auth.uid + "_QF1", request.auth.uid + "_QF2", request.auth.uid + "_QF3", request.auth.uid + "_QF4",
        request.auth.uid + "_SF1", request.auth.uid + "_SF2", request.auth.uid + "_FINAL", request.auth.uid + "_THIRD"
      ];
    }
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    match /profiles/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn() && validProfile(request.resource.data)
        && (request.auth.uid == uid || (isAdmin() && request.resource.data.username == "Participant"));
      allow delete: if false;
    }
    match /rooms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /predictions/{id} {
      allow get: if isAdmin() || ownsId(id) || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && id == request.auth.uid + "_" + request.resource.data.roomId
        && validPick(request.resource.data.roomId, request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && resource.data.roomId == request.resource.data.roomId
        && id == request.auth.uid + "_" + resource.data.roomId
        && validPick(resource.data.roomId, request.resource.data);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && available(resource.data.get("roomId", resource.data.get("matchId", ""))));
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && validLeaderboard(uid, request.resource.data);
      allow delete: if isAdmin();
    }
    match /ticketAwards/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }

    // ==========================================
    // OLD MATCH PREDICTION VALIDATION
    // ==========================================

    function matchExists(matchId) {
      return exists(
        /databases/$(database)/documents/matches/$(matchId)
      );
    }

    function validMatch(matchId) {
      return matchExists(matchId)
        && get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.status != "completed"
        && get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.winner == "";
    }

    function roundIsOpen(roundId) {

      let settingId = "rounds_" + roundId;

      return exists(
        /databases/$(database)/documents/settings/$(settingId)
      )
        && get(
          /databases/$(database)/documents/settings/$(settingId)
        ).data.predictionsOpen == true;
    }

    function validPrediction(matchId, pick) {

      return validMatch(matchId)
        && pick is string
        && get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.roundId is string
        && roundIsOpen(
          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.roundId
        )
        && pick in [
          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.playerA,

          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.playerB
        ];
    }

    // ==========================================
    // ROOM PREDICTION VALIDATION
    // ==========================================

    function roomExists(roomId) {

      return exists(
        /databases/$(database)/documents/rooms/$(roomId)
      );

    }

    function roomPlayers(roomId) {

      return get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data.players;

    }

    function roomStage(roomId) {

      return roomId in ["A", "B", "C", "D"]
        ? "preliminary"

        : roomId in ["SF1", "SF2"]
          ? "semifinal"

          : roomId == "FINAL"
            ? "final"

            : "";

    }

    function expectedRoomSize(roomId) {

      return roomId in ["A", "B", "C", "D"]
        ? 8

        : roomId in ["SF1", "SF2", "FINAL"]
          ? 4

          : 0;

    }

    function roomPredictionOpen(roomId) {

      let stage = roomStage(roomId);
      let settingId = "rounds_" + stage;

      return stage != ""
        && exists(
          /databases/$(database)/documents/settings/$(settingId)
        )
        && get(
          /databases/$(database)/documents/settings/$(settingId)
        ).data.predictionsOpen == true;

    }

    function roomIsReady(roomId) {

      return roomExists(roomId)
        && roomPlayers(roomId) is list
        && roomPlayers(roomId).size() == expectedRoomSize(roomId);

    }

    function roomPredictionBaseValid(roomId, data) {

      return roomIsReady(roomId)

        && roomPredictionOpen(roomId)

        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.resultsPublished != true

        && get(
          /databases/$(database)/documents/rooms/$(roomId)
        ).data.status != "completed"

        && data.uid == request.auth.uid

        && data.roomId == roomId

        && data.stageId == roomStage(roomId)

        && data.displayName is string

        && data.displayName.size() <= 100

        && data.updatedAt is timestamp

        && data.keys().hasAll([
          "uid",
          "roomId",
          "stageId",
          "displayName",
          "selectedPlayers",
          "champion",
          "runnerUp",
          "secondRunnerUp",
          "updatedAt"
        ])

        && data.keys().hasOnly([
          "uid",
          "roomId",
          "stageId",
          "displayName",
          "selectedPlayers",
          "champion",
          "runnerUp",
          "secondRunnerUp",
          "updatedAt"
        ]);

    }

    // ==========================================
    // PRELIMINARY / SEMI-FINAL
    // EXACTLY TWO PLAYERS
    // ==========================================

    function validTop2Prediction(roomId, data) {

      return roomPredictionBaseValid(roomId, data)

        && roomId != "FINAL"

        && data.selectedPlayers is list

        && data.selectedPlayers.size() == 2

        && data.selectedPlayers[0] is string

        && data.selectedPlayers[0] in roomPlayers(roomId)

        && data.selectedPlayers[1] is string

        && data.selectedPlayers[1] in roomPlayers(roomId)

        && data.selectedPlayers[0] != data.selectedPlayers[1]

        && data.champion == ""

        && data.runnerUp == ""

        && data.secondRunnerUp == "";

    }

    // ==========================================
    // GRAND FINAL
    // CHAMPION, 1ST RUNNER-UP AND 2ND RUNNER-UP
    // ==========================================

    function validFinalPrediction(roomId, data) {

      return roomPredictionBaseValid(roomId, data)

        && roomId == "FINAL"

        && data.selectedPlayers is list

        && data.selectedPlayers.size() == 0

        && data.champion is string

        && data.runnerUp is string

        && data.secondRunnerUp is string

        && data.champion in roomPlayers(roomId)

        && data.runnerUp in roomPlayers(roomId)

        && data.secondRunnerUp in roomPlayers(roomId)

        && data.champion != data.runnerUp

        && data.champion != data.secondRunnerUp

        && data.runnerUp != data.secondRunnerUp;

    }

    function validRoomPrediction(roomId, data) {

      return roomId == "FINAL"

        ? validFinalPrediction(roomId, data)

        : validTop2Prediction(roomId, data);

    }

    // ==========================================
    // USER PREDICTION DOCUMENT OWNERSHIP
    // ==========================================

    function ownsRoomPredictionId(predictionId) {

      return signedIn() && (

        predictionId == request.auth.uid + "_A"

        || predictionId == request.auth.uid + "_B"

        || predictionId == request.auth.uid + "_C"

        || predictionId == request.auth.uid + "_D"

        || predictionId == request.auth.uid + "_SF1"

        || predictionId == request.auth.uid + "_SF2"

        || predictionId == request.auth.uid + "_FINAL"

      );

    }

    // ==========================================
    // ADMINS
    // ==========================================

    match /admins/{uid} {

      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      allow write: if false;

    }

    // ==========================================
    // ROOMS
    // ==========================================

    match /rooms/{roomId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    // ==========================================
    // MATCHES
    // ==========================================

    match /matches/{matchId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    // ==========================================
    // SETTINGS
    // ==========================================

    match /settings/{settingId} {

      allow read: if true;

      allow write: if isAdmin();

    }

    // ==========================================
    // PREDICTIONS
    // ==========================================

    match /predictions/{predictionId} {

      // ========================================
      // READ PERMISSIONS
      // ========================================

      allow get: if isAdmin()

        || ownsRoomPredictionId(predictionId)

        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow list: if isAdmin()

        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // ========================================
      // OLD MATCH-BASED PREDICTIONS
      // ========================================

      allow create: if signedIn()

        && predictionId ==
          request.auth.uid + "_" + request.resource.data.matchId

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.matchId is string

        && request.resource.data.displayName is string

        && request.resource.data.displayName.size() <= 50

        && validPrediction(
          request.resource.data.matchId,
          request.resource.data.pick
        );

      allow update: if signedIn()

        && resource.data.uid == request.auth.uid

        && request.resource.data.uid == resource.data.uid

        && request.resource.data.matchId == resource.data.matchId

        && request.resource.data.displayName is string

        && request.resource.data.displayName.size() <= 50

        && validPrediction(
          resource.data.matchId,
          request.resource.data.pick
        );

      // ========================================
      // NEW ROOM-BASED PREDICTIONS
      // ========================================

      allow create: if signedIn()

        && predictionId ==
          request.auth.uid + "_" + request.resource.data.roomId

        && validRoomPrediction(
          request.resource.data.roomId,
          request.resource.data
        );

      allow update: if signedIn()

        && resource.data.uid == request.auth.uid

        && resource.data.roomId == request.resource.data.roomId

        && predictionId ==
          request.auth.uid + "_" + resource.data.roomId

        && validRoomPrediction(
          resource.data.roomId,
          request.resource.data
        );

      // ========================================
      // DELETE OWN PREDICTION
      // ========================================

      allow delete: if signedIn()

        && resource.data.uid == request.auth.uid

        && resource.data.roomId is string

        && roomPredictionOpen(resource.data.roomId)

        && roomIsReady(resource.data.roomId)

        && get(
          /databases/$(database)/documents/rooms/$(resource.data.roomId)
        ).data.resultsPublished != true

        && get(
          /databases/$(database)/documents/rooms/$(resource.data.roomId)
        ).data.status != "completed";

      allow delete: if isAdmin();

    }

    // ==========================================
    // LEADERBOARD
    // ==========================================

    match /leaderboard/{uid} {

      allow read: if true;

      allow write: if isAdmin();

    }

    // ==========================================
    // LUCKY DRAW
    // ==========================================

    match /ticketAwards/{awardId} {

      allow read: if isAdmin()

        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();

    }

    // ==========================================
    // DENY OTHER COLLECTIONS
    // ==========================================

    match /{document=**} {

      allow read, write: if false;

    }

  }
}